[Unit]
Description=Attack Shark R5 Ultra Control Center Daemon (Rust + Slint)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/local/bin/attackshark-r5-ultra-control
Restart=always
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
