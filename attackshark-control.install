post_install() {
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger 2>/dev/null || true
    echo "------------------------------------------------------------------"
    echo " Attack Shark R5 Ultra Control Center installed successfully!     "
    echo " To enable & start the background daemon immediately:             "
    echo "   systemctl --user enable --now attackshark-control.service      "
    echo "------------------------------------------------------------------"
}

post_upgrade() {
    post_install
}

post_remove() {
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger 2>/dev/null || true
}
